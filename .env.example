# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Домен сайта (например, бесплатный с duckdns.org).
DOMAIN=bstu-tests.duckdns.org

# Общий вход для преподавателей.
EDITOR_LOGIN=kafedra
EDITOR_PASSWORD=

# Вход администратора (выгрузка в Moodle, восстановление, смена паролей).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Ключ подписи cookie. Можно оставить пустым — сгенерируется сам и сохранится рядом с базой.
# Сгенерировать вручную: openssl rand -hex 32
SECRET_KEY=

# Пароли из .env записываются в базу только при первом запуске.
# Дальше их меняют в админке.
